generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum GameSource {
  MANUAL
  STEAM
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  reviews      Review[]
}

model Game {
  id          String     @id @default(uuid())
  source      GameSource @default(MANUAL)
  // ID do jogo na fonte externa (ex.: appid da Steam). Nulo para jogos cadastrados manualmente.
  externalId  String?
  title       String
  description String?
  genres      String[]
  developer   String?
  releaseDate DateTime?
  coverUrl    String?
  // Agregados mantidos pelo ReviewsService para evitar AVG() a cada listagem.
  ratingAvg   Float      @default(0)
  ratingCount Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  reviews     Review[]

  // Garante idempotência da sincronização: o mesmo jogo da mesma fonte nunca é duplicado.
  @@unique([source, externalId])
  @@index([title])
  @@index([ratingAvg])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  gameId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  // Um usuário avalia cada jogo uma única vez.
  @@unique([userId, gameId])
  @@index([gameId, createdAt])
}
