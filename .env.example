# Aplicação
PORT=3000

# PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gamecatalog

# Redis
REDIS_URL=redis://localhost:6379

# JWT (troque por um valor longo e aleatório em produção)
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN_SECONDS=3600

# Sincronização do catálogo (Steam)
SYNC_ENABLED=true
STEAM_APP_IDS=620,292030,1245620,105600,1091500

# Usuário admin criado pelo seed (apenas desenvolvimento)
SEED_ADMIN_EMAIL=admin@gamecatalog.local
SEED_ADMIN_PASSWORD=admin12345
